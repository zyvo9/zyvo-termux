<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/thought_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/thought_spinner"
            android:layout_width="16dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="⠋"
            android:textColor="@color/warn"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/thought_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Thinking"
            android:textColor="@color/warn"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/thought_chevron"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/warn"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/thought_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="22dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
