<?xml version="1.0" encoding="utf-8"?>
<!-- "Thought for 4s >" row (Grok reference screenshot 2026-11-14). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="6dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/thought_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/thought_spinner"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lc_lightbulb"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/thought_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Thinking"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/thought_chevron"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lc_chevron_down"
            android:tint="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/thought_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="23dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
