<?xml version="1.0" encoding="utf-8"?>
<!-- Flat, quiet tool row: icon + verb + target + diff counter, ZCode-style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:id="@+id/tool_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tool_spinner"
            android:layout_width="13dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="⠋"
            android:textColor="@color/text_disabled"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tool_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lc_terminal"
            android:tint="@color/text_disabled" />

        <TextView
            android:id="@+id/tool_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxLines="1"
            android:text="Terminal"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/command"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_disabled"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/diff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/ok"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/output"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="20dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:lineSpacingExtra="1dp"
        android:textColor="@color/text_disabled"
        android:textIsSelectable="true"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/expand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="20dp"
        android:text="@string/tap_expand"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <View
        android:id="@+id/sweep"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_sweep"
        android:visibility="gone" />

</LinearLayout>
